REMOTION_AWS_ACCESS_KEY_ID=
REMOTION_AWS_SECRET_ACCESS_KEY=

OPENAI_API_KEY=

# IAFIT Content Studio — Clipping engine (server-only, never expose to browser)
MUAPI_API_KEY=
# Optional override (defaults to https://api.muapi.ai/api/v1)
# MUAPI_BASE_URL=

# IAFIT Intelligence layer (server-only)
# Transcription (Deepgram pre-recorded API, accepts the S3 presigned GET URL).
DEEPGRAM_API_KEY=
# LLM moment selection (OpenRouter, OpenAI-compatible). Reuses the Vercel AI SDK.
OPENROUTER_API_KEY=
# Optional model override (defaults to openai/gpt-4o). Centralized in llm-select.ts.
# OPENROUTER_MODEL=openai/gpt-4o

# Cortes — upload de vídeo local para a MuAPI (S3 presigned, server-only)
# Reusa REMOTION_AWS_ACCESS_KEY_ID / REMOTION_AWS_SECRET_ACCESS_KEY acima.
# Bucket PRIVADO dedicado (crie com scripts/setup-uploads-bucket.sh)
CLIPS_UPLOAD_BUCKET=
# Opcionais (defaults: 1 GiB / 6h / us-east-1)
# CLIPS_UPLOAD_MAX_BYTES=1073741824
# CLIPS_UPLOAD_GET_EXPIRY_SECONDS=21600
# Região do bucket de upload (pode diferir da região do Remotion Lambda).
# Ex.: us-east-2 se a conta só tiver essa região habilitada.
# CLIPS_UPLOAD_REGION=us-east-1